// Memoized Visual Component
const MindMapCanvas = memo(({ data, onNodeClick }: { data: MindMapNode, onNodeClick: (n: MindMapNode) => void }) => {
    // Heavy calculation memoized
    const layout = useMemo(() => {
        const pos: Record<string, {x:number, y:number}> = {};
        let cy = 0;
        const traverse = (n: MindMapNode, d: number) => {
            if(!n.children?.length) { pos[n.id] = {x: 50+d*280, y: cy}; cy += 100; return cy; }
            const ys = n.children.map(c => traverse(c, d+1));
            const y = (Math.min(...ys)+Math.max(...ys))/2;
            pos[n.id] = {x: 50+d*280, y};
            return y;
        };
        traverse(data, 0);
        return pos;
    }, [data]); // Only recalculate if data structure changes

    const find = (n: MindMapNode, id: string): MindMapNode|null => { 
      if(n.id===id) return n; 
      if(n.children) for(const c of n.children){const f=find(c,id);if(f)return f;} 
      return null; 
    };

    return (
        <div className="w-full h-full bg-slate-50 overflow-auto relative cursor-grab active:cursor-grabbing">
            <svg width="4000" height="4000" className="absolute pointer-events-none">
                {Object.keys(layout).map(src => {
                    const n = find(data, src); if(!n?.children) return null;
                    return n.children.map(c => {
                        const s=layout[src], t=layout[c.id]; if(!t) return null;
                        return <path key={`${src}-${c.id}`} d={`M ${s.x+240} ${s.y+35} C ${s.x+280} ${s.y+35}, ${t.x-40} ${t.y+35}, ${t.x} ${t.y+35}`} stroke="#cbd5e1" strokeWidth="2" fill="none"/>;
                    });
                })}
            </svg>
            {Object.entries(layout).map(([id, p]) => {
                const n = find(data, id); if(!n) return null;
                return (
                    <div key={id} onClick={() => onNodeClick(n)} className="absolute w-64 p-4 bg-white rounded-xl border-2 border-slate-100 hover:border-indigo-400 shadow-sm cursor-pointer transition-all hover:scale-105" style={{left: p.x, top: p.y}}>
                        <div className="flex justify-between mb-2">
                             <span className="text-[10px] bg-slate-100 text-slate-500 px-2 py-0.5 rounded uppercase font-bold">{n.type}</span>
                             {n.quizScore!==undefined && <span className="text-[10px] bg-green-100 text-green-700 px-2 py-0.5 rounded font-bold">{n.quizScore}%</span>}
                        </div>
                        <div className="font-bold text-sm text-slate-800 line-clamp-2">{n.text}</div>
                    </div>
                );
            })}
        </div>
    );
}, (prev, next) => prev.data === next.data); // Custom comparison for perf

// Advanced Revision Hook
const useRevisionSession = (node: MindMapNode, cards: RevisionCard[]) => {
    const { isOnline } = useNeuroMap();
    const [sessionCards, setSessionCards] = useState<RevisionCard[]>(cards);
    const [loading, setLoading] = useState(false);

    const generateCards = useCallback(async () => {
        if(cards.length > 0) return;
        setLoading(true);
        try {
             if (!isOnline) throw new Error("Offline");
             const res = await callGemini(`Gen 3 flashcards for "${node.text}"`, "JSON: [{front, back}]");
             if(Array.isArray(res)) {
                 const newCards = res.map((c:any,i:number)=>({id:`gen-${Date.now()}-${i}`, nodeId:node.id, front:c.front, back:c.back, sm2Data:{interval:0,easeFactor:2.5,step:0,nextReview:new Date().toISOString()}}));
                 setSessionCards(newCards);
                 return newCards;
             }
        } catch(e) {
             // Offline fallback
             const newCard = {id:`loc-${Date.now()}`, nodeId:node.id, front:`Define: ${node.text}`, back:"...", sm2Data:{interval:0,easeFactor:2.5,step:0,nextReview:new Date().toISOString()}};
             setSessionCards([newCard]);
             return [newCard];
        } finally { setLoading(false); }
    }, [node, cards.length, isOnline]);

    return { sessionCards, loading, generateCards };
};

// --- Modals ---
const GeneratorModal = ({ isOpen, onClose }: { isOpen: boolean, onClose: () => void }) => {
    const { addDoc } = useNeuroMap();
    const [input, setInput] = useState('');
    const [mode, setMode] = useState('topic');
    const [loading, setLoading] = useState(false);
    const { checkLimit } = useRateLimit(5, 60000); // 5 calls per minute

    const handleGen = async () => {
        if (!checkLimit()) { alert("Rate limit exceeded. Wait a moment."); return; }
        setLoading(true);
        try {
            const prompt = mode === 'curriculum' 
                ? `Create Semester Plan. Root=Course. Children=Weeks. Output JSON.` 
                : `Create Mind Map. Root=Topic. Children=Subtopics. Output JSON.`;
            
            const data = await callGemini(`Input: "${sanitizeInput(input)}"`, prompt);
            
            // Hydrate IDs
            const hydrate = (n: any): any => ({ ...n, id: Math.random().toString(36).substr(2,9), isExpanded: true, children: n.children?.map(hydrate) });
            
            addDoc({
                id: `doc-${Date.now()}`, title: data.title || input, type: mode === 'topic' ? 'mindmap' : 'curriculum',
                uploadDate: new Date().toISOString(), lastModified: new Date().toISOString(),
                tree: hydrate(data.root), cards: []
            });
            onClose();
        } catch (e) { alert("Generation failed."); }
        setLoading(false);
    };

    if (!isOpen) return null;
    return (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
            <div className="bg-white rounded-2xl p-6 w-full max-w-md relative">
                {loading && <div className="absolute inset-0 bg-white/90 flex items-center justify-center z-10"><Loader2 className="animate-spin w-8 h-8 text-indigo-600"/></div>}
                <div className="flex justify-between mb-4"><h2 className="text-xl font-bold">New Project</h2><button onClick={onClose}><X/></button></div>
                <div className="flex bg-slate-100 p-1 rounded-lg mb-4">
                    <button onClick={()=>setMode('topic')} className={`flex-1 py-2 text-sm font-bold rounded ${mode==='topic'?'bg-white shadow':'text-slate-500'}`}>Mind Map</button>
                    <button onClick={()=>setMode('curriculum')} className={`flex-1 py-2 text-sm font-bold rounded ${mode==='curriculum'?'bg-white shadow':'text-slate-500'}`}>Timeline</button>
                </div>
                <textarea value={input} onChange={e=>setInput(e.target.value)} className="w-full h-32 border rounded-xl p-3 mb-4" placeholder="Enter topic..."/>
                <button onClick={handleGen} disabled={!input.trim()} className="w-full bg-indigo-600 text-white py-3 rounded-xl font-bold">Generate</button>
            </div>
        </div>
    );
};

