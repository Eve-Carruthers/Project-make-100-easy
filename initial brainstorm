const RevisionCardDeck = ({ cards, onUpdateCard, onClose }: any) => {
    const [index, setIndex] = useState(0);
    const [flipped, setFlipped] = useState(false);
    const [timer, setTimer] = useState(0);

    useEffect(() => { const t = setInterval(()=>setTimer(p=>p+1),1000); return ()=>clearInterval(t); }, [index]);

    const handleGrade = (q:number) => {
        const c = cards[index];
        const next = new Date(); next.setDate(next.getDate() + (q>=3?1:0));
        onUpdateCard({...c, sm2Data:{...c.sm2Data, nextReview:next.toISOString()}});
        if(index<cards.length-1) { setIndex(i=>i+1); setFlipped(false); setTimer(0); } else onClose();
    };

    if(!cards.length) return null;
    const card = cards[index];

    return (
        <div className="h-full flex flex-col">
            <TeacherRadar time={timer} />
            <div className="flex-grow relative perspective-1000 cursor-pointer" onClick={()=>!flipped&&setFlipped(true)}>
                <div className={`w-full h-full transition-all duration-500 transform preserve-3d ${flipped?'rotate-y-180':''}`}>
                    <div className="absolute inset-0 backface-hidden bg-white border-2 border-slate-100 rounded-xl p-6 flex items-center justify-center text-center shadow-sm">
                        <h3 className="font-bold text-lg">{card.front}</h3>
                    </div>
                    <div className="absolute inset-0 backface-hidden rotate-y-180 bg-slate-900 rounded-xl p-6 flex items-center justify-center text-center text-white">
                        <p>{card.back}</p>
                    </div>
                </div>
            </div>
            {flipped && (
                <div className="grid grid-cols-3 gap-2 mt-4">
                    <button onClick={()=>handleGrade(0)} className="p-3 bg-red-100 text-red-700 rounded font-bold text-xs">Fail</button>
                    <button onClick={()=>handleGrade(3)} className="p-3 bg-amber-100 text-amber-700 rounded font-bold text-xs">Hard</button>
                    <button onClick={()=>handleGrade(5)} className="p-3 bg-green-100 text-green-700 rounded font-bold text-xs">Easy</button>
                </div>
            )}
        </div>
    );
};

// --- App Root ---
const MainLayout = () => {
    const [activeDoc, setActiveDoc] = useState<DocumentData|null>(null);
    const { importData, exportData } = useNeuroMap();
    const [settingsOpen, setSettingsOpen] = useState(false);

    return (
        <div className="h-screen flex bg-slate-50 font-sans text-slate-900">
            {/* Sidebar */}
            <div className="w-20 bg-slate-900 flex flex-col items-center py-6 gap-6 shadow-xl z-20">
                <div className="w-12 h-12 bg-indigo-600 rounded-xl flex items-center justify-center mb-4"><Brain className="text-white"/></div>
                <button onClick={()=>setActiveDoc(null)} className={`p-3 rounded-xl ${!activeDoc?'bg-white/10 text-white':'text-slate-400'}`}><Layout/></button>
                <div className="mt-auto flex flex-col gap-4">
                    <button onClick={()=>setSettingsOpen(true)} className="p-3 text-slate-400 hover:text-white"><Settings/></button>
                </div>
            </div>

            <div className="flex-grow flex flex-col overflow-hidden relative">
                {activeDoc ? <Editor doc={activeDoc} onClose={()=>setActiveDoc(null)}/> : <Dashboard onOpen={setActiveDoc}/>}
                
                {settingsOpen && (
                    <div className="absolute inset-0 bg-black/50 z-50 flex items-center justify-center">
                        <div className="bg-white p-6 rounded-xl w-96">
                            <h2 className="font-bold text-lg mb-4">Data Management</h2>
                            <div className="space-y-3">
                                <button onClick={exportData} className="w-full p-3 bg-indigo-50 text-indigo-700 rounded font-bold flex gap-2"><Download className="w-4 h-4"/> Export Backup</button>
                                <button onClick={()=>{const i=prompt("Paste JSON"); if(i)importData(i)}} className="w-full p-3 bg-slate-100 text-slate-700 rounded font-bold flex gap-2"><UploadCloud className="w-4 h-4"/> Import Data</button>
                            </div>
                            <button onClick={()=>setSettingsOpen(false)} className="mt-6 w-full py-2 border rounded">Close</button>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

export default function App() {
    return (
        <ErrorBoundary>
            <AppProvider>
                <MainLayout />
            </AppProvider>
        </ErrorBoundary>
    );
}


