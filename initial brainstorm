interface GlobalState {
  docs: DocumentData[];
  userStats: UserStats;
  isOnline: boolean;
  addDoc: (d: DocumentData) => void;
  updateDoc: (d: DocumentData) => void;
  deleteDoc: (id: string) => void;
  updateStats: (s: UserStats) => void;
  exportData: () => void;
  importData: (json: string) => void;
}

const AppContext = createContext<GlobalState | null>(null);

const useNeuroMap = () => {
  const context = useContext(AppContext);
  if (!context) throw new Error("useNeuroMap must be used within AppProvider");
  return context;
};

// Offline Sync Hook
const useOfflineSync = () => {
  const [isOnline, setIsOnline] = useState(navigator.onLine);
  useEffect(() => {
    const h = () => setIsOnline(navigator.onLine);
    window.addEventListener('online', h);
    window.addEventListener('offline', h);
    return () => { window.removeEventListener('online', h); window.removeEventListener('offline', h); };
  }, []);
  return isOnline;
};

// Provider Component
const AppProvider = ({ children }: { children: React.ReactNode }) => {
  const [docs, setDocs] = useState<DocumentData[]>(() => {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'); } catch { return []; }
  });
  
  const [userStats, setUserStats] = useState<UserStats>(() => {
    try { 
      const s = JSON.parse(localStorage.getItem(STORAGE_KEY + "_STATS") || '{}');
      return { shields: 3, streak: 1, totalReviews: 0, archetype: 'Steady', ...s };
    } catch { return { shields: 3, streak: 1, totalReviews: 0, archetype: 'Steady' }; }
  });

  const isOnline = useOfflineSync();

  // Persistence Effects
  useEffect(() => localStorage.setItem(STORAGE_KEY, JSON.stringify(docs)), [docs]);
  useEffect(() => localStorage.setItem(STORAGE_KEY + "_STATS", JSON.stringify(userStats)), [userStats]);

  const addDoc = (d: DocumentData) => setDocs(p => [d, ...p]);
  const updateDoc = (d: DocumentData) => setDocs(p => p.map(x => x.id === d.id ? d : x));
  const deleteDoc = (id: string) => setDocs(p => p.filter(x => x.id !== id));
  const updateStats = (s: UserStats) => setUserStats(s);

  // Data Management
  const exportData = () => {
    const blob = new Blob([JSON.stringify({ docs, userStats }, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `neuromap_backup_${new Date().toISOString().split('T')[0]}.json`;
    a.click();
  };

  const importData = (json: string) => {
    try {
      const data = JSON.parse(json);
      if (data.docs && Array.isArray(data.docs)) {
        setDocs(data.docs);
        if (data.userStats) setUserStats(data.userStats);
        alert("Import successful!");
      } else throw new Error("Invalid format");
    } catch (e) { alert("Import failed: Invalid JSON"); }
  };

  return (
    <AppContext.Provider value={{ docs, userStats, isOnline, addDoc, updateDoc, deleteDoc, updateStats, exportData, importData }}>
      {children}
    </AppContext.Provider>
  );
};

